  </div>
</BaseLayout>

<style>
  /* Center the preview area and make it full-width */
  .fair-housing-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 2em 1em;
    box-sizing: border-box;
  }

  /* Core preview styles */
  .pdf-preview-link {
    display: block;
    width: 80%;
    max-width: 1400px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: transform 0.2s ease-in-out;
    cursor: pointer;
    background: #fff;
  }

  .pdf-preview-link:hover {
    transform: scale(1.01);
  }

  /* Image styling */
  .pdf-preview {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Caption below image */
  .pdf-caption {
    display: block;
    text-align: center;
    font-weight: 600;
    color: #004080;
    padding: 0.75em 0;
  }

  /* 🖥️ Large desktops: reduce width slightly */
  @media (min-width: 1600px) {
    .pdf-preview-link {
      width: 70%;
    }
  }

  /* 📱 Tablets & phones: use nearly full width */
  @media (max-width: 1024px) {
    .pdf-preview-link {
      width: 90%;
    }
  }

  @media (max-width: 600px) {
    .pdf-preview-link {
      width: 100%;
      box-shadow: none;
      border-radius: 0;
    }

    .pdf-caption {
      font-size: 0.95rem;
    }
  }
</style>
