---
import { NavItem } from "../data/nav.js";
import { NAV_LINKS } from "../data/nav.js";

interface Props {
  current?: string | null;
}
const { current = null } = Astro.props;
---

<nav>
  {
    NAV_LINKS.map((item: NavItem) =>
      "href" in item ? (
        <a
          href={item.href}
          class={current != null && current === item.key ? "selected" : ""}
        >
          {item.label}
        </a>
      ) : (
        <details
          class={
            current != null && item.links.some((link) => link.key === current)
              ? "dropdown selected"
              : "dropdown"
          }
        >
          <summary class="dropdown-trigger">{item.label}</summary>
          <div class="dropdown-menu">
            {item.links.map((link) => (
              <a
                href={link.href}
                class={
                  current != null && current === link.key ? "selected" : ""
                }
              >
                {link.label}
              </a>
            ))}
          </div>
        </details>
      ),
    )
  }
</nav>

<style>
  nav {
    position: fixed;
    inset: 0; /* top:0 right:0 bottom:0 left:0 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    background: var(--primary-color);
    z-index: 20;
    padding: 2rem;
    box-sizing: border-box;
  }

  .dropdown,
  .dropdown-trigger,
  .dropdown-menu,
  nav a {
    width: min(100%, 30rem);
  }

  nav a,
  .dropdown-trigger {
    color: #fff;
    text-decoration: none;
    font-size: clamp(1.25rem, 4vw, 2.5rem);
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
    will-change: transform, background-color;
    background: transparent;
    box-shadow: none;
    display: block;
    text-align: center;
    box-sizing: border-box;
  }

  nav a:hover,
  .dropdown-trigger:hover {
    transform: translateY(-4px) scale(1.02);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
  }

  nav a:active,
  .dropdown-trigger:active {
    transform: translateY(0) scale(0.995);
    background: rgba(255, 255, 255, 0.1);
  }

  nav a.selected,
  .dropdown.selected .dropdown-trigger,
  .dropdown.selected .dropdown-menu a.selected {
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.6);
  }

  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    list-style: none;
    cursor: pointer;
  }

  .dropdown-trigger::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    width: min(100%, 30rem);
  }

  .dropdown-menu a {
    font-size: clamp(0.95rem, 3vw, 1.5rem);
    width: 100%;
    padding: 0.65rem 1rem;
  }

  @media (min-width: 900px) {
    nav {
      align-items: flex-start;
      padding-left: 4rem;
    }

    nav a,
    .dropdown-trigger {
      width: auto;
      min-width: 12rem;
      font-size: clamp(1rem, 1.8vw, 1.5rem);
      padding: 0.5rem 1rem;
      text-align: left;
    }

    .dropdown,
    .dropdown-menu {
      width: auto;
    }

    .dropdown-menu {
      align-items: flex-start;
      min-width: 15rem;
    }
  }
</style>
