---
import Logo from "./Logo.astro";
import Nav from "./NavBar.astro";
import Hamburger from "./Hamburger.astro";

const { current = "" } = Astro.props;
---

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
    height: 150px;
    max-width: 1400px;
    padding: 2em;
    z-index: 100;
    background: var(--foreground-body);
  }

  #hamburger-container {
    display: none;
    align-items: center;
    position: fixed;
    top: 2em;
    right: 2em;
    z-index: 50;
  }

  #nav-container {
    display: flex;
    align-items: center;
    height: 100%;
  }

  @media (max-width: 786px) {
    #nav-container {
      display: none;
    }

    #hamburger-container {
      display: flex;
    }
  }

  .header-offset {
    height: 150px;
  }
</style>

<header>
  <Logo />
  <div id="nav-container">
    <Nav current={current} />
  </div>
  <div id="hamburger-container">
    <Hamburger />
  </div>
</header>
<div class="header-offset"></div>
