---

---

<div id="shooting-star-scene" transition:persist>
  <canvas id="bgCanvas"></canvas>
</div>

<script>
  function initBackground() {
    const canvas = document.getElementById("bgCanvas") as HTMLCanvasElement;
    if (!canvas) return;

    if (canvas.dataset.initialized === "true") {
      return;
    }

    canvas.dataset.initialized = "true";

    if (!(canvas instanceof HTMLCanvasElement)) return;

    const ctx: CanvasRenderingContext2D = canvas.getContext("2d")!;
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationId = 0;

    const stars: Star[] = [];
    const shootingStars: ShootingStar[] = [];

    type TerrainLayer = {
      points: number[];
      color: string;
    };

    const terrainLayers: TerrainLayer[] = [];

    function generateTerrain(
      baseHeight: number,
      displacement: number,
    ): number[] {
      const points: number[] = [];

      const power = Math.pow(2, Math.ceil(Math.log(width) / Math.log(2)));

      points[0] = baseHeight;
      points[power] = baseHeight;

      let disp = displacement;
      for (let i = 1; i < power; i *= 2) {
        for (let j = power / i / 2; j < power; j += power / i) {
          points[j] =
            (points[j - power / i / 2] + points[j + power / i / 2]) / 2 +
            (Math.random() * 2 - 1) * disp;
        }

        disp *= 0.6;
      }

      return points;
    }

    function drawTerrain(layer: TerrainLayer) {
      ctx.fillStyle = layer.color;

      ctx.beginPath();
      ctx.moveTo(0, layer.points[0]);

      for (let x = 1; x <= width; x++) {
        const point = layer.points[x];

        if (point !== undefined) {
          ctx.lineTo(x, point);
        }
      }

      ctx.lineTo(width, height);
      ctx.lineTo(0, height);
      ctx.closePath();

      ctx.fill();
    }

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;

      canvas!.width = width;
      canvas!.height = height;

      terrainLayers.length = 0;

      terrainLayers.push({
        points: generateTerrain(height / 2 + 120, 100),
        color: "#191D4C",
      });

      terrainLayers.push({
        points: generateTerrain(height / 2 + 250, 100),
        color: "rgb(17,20,40)",
      });

      terrainLayers.push({
        points: generateTerrain(height / 2 + 350, 130),
        color: "rgb(10,10,5)",
      });
    }

    class Star {
      x!: number;
      y!: number;
      size!: number;
      speed!: number;

      constructor() {
        this.reset();
        this.x = Math.random() * width;
      }

      reset() {
        this.x = width;
        this.y = Math.random() * height;
        this.size = Math.random() * 2;
        this.speed = Math.random() * 0.05;
      }

      update() {
        this.x -= this.speed;

        if (this.x < 0) {
          this.reset();
        }

        ctx.fillRect(this.x, this.y, this.size, this.size);
      }
    }

    class ShootingStar {
      x!: number;
      y!: number;
      len!: number;
      speed!: number;
      size!: number;
      active!: boolean;
      waitTime!: number;

      constructor() {
        this.reset();
      }

      reset() {
        this.x = Math.random() * width;
        this.y = 0;
        this.len = Math.random() * 80 + 10;
        this.speed = Math.random() * 10 + 6;
        this.size = Math.random() + 0.1;
        this.active = false;
        this.waitTime = Date.now() + Math.random() * 3000 + 500;
      }

      update() {
        if (!this.active) {
          if (Date.now() > this.waitTime) {
            this.active = true;
          }
          return;
        }

        this.x -= this.speed;
        this.y += this.speed;

        if (this.x < -this.len || this.y > height) {
          this.reset();
          return;
        }

        ctx.lineWidth = this.size;
        ctx.beginPath();
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x + this.len, this.y - this.len);
        ctx.stroke();
      }
    }

    resize();

    const starCount = Math.max(150, Math.floor(height * 0.35));

    for (let i = 0; i < starCount; i++) {
      stars.push(new Star());
    }

    shootingStars.push(new ShootingStar());
    shootingStars.push(new ShootingStar());

    function animate() {
      ctx.fillStyle = "#110E19";
      ctx.fillRect(0, 0, width, height);

      ctx.fillStyle = "#FFFFFF";
      ctx.strokeStyle = "#FFFFFF";

      for (const star of stars) {
        star.update();
      }

      for (const shootingStar of shootingStars) {
        shootingStar.update();
      }

      for (const layer of terrainLayers) {
        drawTerrain(layer);
      }

      animationId = requestAnimationFrame(animate);
    }

    window.addEventListener("resize", resize);

    animate();

    window.addEventListener("beforeunload", () => {
      cancelAnimationFrame(animationId);
    });
  }

  initBackground();
  document.addEventListener("astro:page-load", initBackground);
</script>

<style>
  #shooting-star-scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  canvas {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
  }
</style>
